# Previous TP=2 Zig serving profile, for the q28-v2 pack: the serving set measured in docs/ZIG-RESULTS.md.
# The recommended profile is config/prod-zig-flash17.env.example (flash17); this one is its rollback.
# Copy to config/prod-zig.env on EACH node; set these node-local paths and link settings.
# This profile requires the CUDA Zig port and generated assets described in docs/ZIG-SERVE.md,
# including an AOT fill that covers 4K prefill pieces, replay runs and the INDEX_BOUND twins.
ZIG_COMMIT="<engine-source-commit>"   # the engine/zig revision your image was built from (image label)
IMAGE="<your-built-zig-image>"
TF_TP_MASTER="<rank-0-link-address>"
TF_TP_PORT=29571
TF_COMM_BACKEND=roce
NCCL_SOCKET_IFNAME="<link-interface>"
NCCL_IB_HCA="<cabled-RDMA-devices>"
MODEL_DIR="<absolute-model-directory>"
ENGRAM_DIR="<absolute-rank-specific-engram-directory>"
ASSETS_DIR="<absolute-rank-specific-assets-directory>"
PREPARED_DIR="<absolute-zig-prepared-directory>"
STATE_DIR="<absolute-state-directory>"
CACHE_DIR="<absolute-calibration-directory>"
HOST=localhost
PORT=8000
# rope.bin needs CONTEXT + 2048 rows (dsv41_rope_tables.py's default with this env sourced)
TF_DSV41_CONTEXT=1048576
TF_DSV41_ASSETS=/assets

# Engine values exported from the serving profile, with the measured all-on additions.
TF_DSV41_R1=1
TF_DSV41_DRAFTS=1
TF_DSV41_OWN_PREFILL=1
TF_DSV41_GRAPHS=1
TF_DSV41_SAMPLING=1
TF_DSV41_SLOTS=4
TF_DSV41_SLOT_DRAFTS=1
# Paged KV pool shared by the slots: 3.0M tokens with split KV (one slot up to CONTEXT, 750K each at 4 live).
TF_DSV41_POOL_TOKENS=3000000
# Split KV: compressed KV rows sharded over the ranks instead of replicated (TP >= 2; see docs/ZIG-SERVE.md).
TF_DSV41_KV_SPLIT=1
# Split KV's owner-packed exchange where every rank's transport takes device lengths (otherwise the dense exchange).
TF_DSV41_KV_SPLIT_COMPACT=1
# Dense weight forms written over their trellis instead of beside it (frees their copy for the pool).
TF_DSV41_FORMS_INPLACE=1
TF_DSV41_INDEX_KV=fp8
TF_DSV41_EXPERT_TOPP=0.85
TF_DSV41_ENGRAM_DIR=/engram
TF_DSV41_PREPARED=/prepared
TF_DSV41_PREPARED_WRITE=1
TF_DSV41_PLAN_TIMEOUT=1800
TF_DSV41_SESSIONS=1
TF_DSV41_SESSION_RAM_MIB=256
TF_DSV41_SESSION_DISK=/sessions
TF_DSV41_SESSION_DISK_GIB=128
TF_DSV41_SESSION_DISK_MIN=1024
TF_DSV41_FLOOR_GIB=5
TF_DSV41_FLOOR_HARD_GIB=4
TF_DSV41_REQUEST_LOG=/state/requests.jsonl
TF_DSV41_DISCONNECT=1
# Seconds requests in progress may finish after SIGTERM / SIGINT before both ranks stop at a round boundary.
TF_DSV41_DRAIN_S=20
# Seconds between keepalives on a stream that has not sent its first token (0: none).
TF_DSV41_SSE_KEEPALIVE_S=15
TF_DSV41_THINKING=1
TF_DSV41_DEFAULT_EFFORT=high
TF_DSV41_SCHEMA_PROMPT=1
# Image input: DeepSeek's vision tower on rank 0 (placeholder: each image becomes a notice; reject: HTTP 400).
TF_DSV41_IMAGES=native
# Folder in the /cache mount holding bias_vl.safetensors (both ranks; see docs/IMAGES.md); unset: the text bias.
TF_DSV41_BIAS_VL=/cache/dsv41-bias-vl
GLM53_TF_ROCE_MAX_KB=1024
TF_DSV41_INDEX_BUDGET_MIB=64
TF_DSV41_PREFETCH_AHEAD=1
TF_DSV41_SPEC_DRAFT=1
TF_DSV41_DRAFT_GRAPHS=1
TF_DSV41_ROWS_CAP=64
TF_DSV41_GRAMMAR=1
TF_DSV41_TOOL_GRAMMAR=0
TF_DSV41_PF_DENSE=fused
# config/pfdense-table.json in CACHE_DIR (scripts/run-zig.sh copies it there when missing)
TF_DSV41_PF_DENSE_TABLE=/cache/pfdense-table.json
TF_DSV41_PLAN_LINK=rdma
TF_DSV41_PLAN_PIN=auto
TF_DSV41_L2PF=1
TF_DSV41_L2PF_MB=12
TF_DSV41_L2PF_PACE_GBPS=150
TF_DSV41_DEPTH_JOINT=0
TF_DSV41_ENGRAM_GATE=1
TF_DSV41_BRANCHES=1
TF_DSV41_BRANCHES_PRIO=side
TF_DSV41_MHC_DEFER=1
GLM53_TF_ROCE_FAST=1
TF_DSV41_GREEDY_GPU=1
TF_DSV41_PREFILL=replay
TF_DSV41_GM_V2=1
# Final serving set: the 40 settings the measured serving boot applied over the profile above (later values win;
# shown here once, with their effective values). Each is default-off in the engine and opted into here.
TF_DSV41_PREFILL_PIECES=1
TF_DSV41_SESSION_SLOTS=1
TF_DSV41_TAIL_JOIN=1
TF_DSV41_DRAFT_TIMED=1
TF_DSV41_CODE_ACCEPT=0
TF_DSV41_ROUTER_GROUP_ROT=1
TF_DSV41_MHC_PFDEC=17
TF_DSV41_DRAFT_BATCH_PROJ=1
TF_DSV41_DRAFT_CHAIN=1
TF_DSV41_DRAFT_OVERLAP=1
TF_DSV41_ROUND_GRAPH=1
TF_DSV41_KV_NORM_STORE=1
TF_DSV41_LOOKUP_PLAN=1
TF_DSV41_JOIN_DRAFTS=1
TF_DSV41_PIECE_RUNS=1
TF_DSV41_REPLAY_RUNS=1
TF_DSV41_PF_4K=1
TF_DSV41_PF_4K_MEMORY_OK=1
TF_DSV41_PREFILL_CHUNK=4096
TF_DSV41_PREFILL_ROWS=4096
TF_DSV41_PF_WS_FLOOR_GIB=3.5
TF_DSV41_ENGRAM_AIO=1
TF_DSV41_DRAFT_CAPTURE=1
TF_DSV41_MHC_DEFER_AT=exchange
TF_DSV41_LIN2=1
TF_DSV41_GRAPH_FLOOR=hold
TF_DSV41_PF_WS_SHARE=1
TF_DSV41_INDEX_BOUND=1
# Draft pricing from this engine's own boot measurement: the first boot times its windows on every rank and stores
# calib-zig-<shape>.json in CALIB_DIR; later boots read it. Pin one measured table with CALIB_FILE once you have it.
TF_DSV41_CALIB=zig
TF_DSV41_CALIB_DIR=/state/calib-zig
# TF_DSV41_CALIB_FILE=/state/calib-zig/<calib-zig-file>.json

# 4K prefill falls back to 2K segments (same bits) when either rank cannot keep PF_WS_FLOOR_GIB free.
# For a conservative 2K profile set PF_4K=0, drop PF_4K_MEMORY_OK and PF_WS_FLOOR_GIB, and use CHUNK / ROWS 2048.
# Changing these (or slots, rows cap, context) changes the AOT set: run scripts/run-zig.sh N --check-aot and compile
# what it reports (docs/ZIG-SERVE.md, "Changing serving settings").

# Explicit opt-ins in the public source export.
export TF_DSV41_LOOKUP=1
export TF_DSV41_ENGRAM_PREFETCH=1

# Supervision. scripts/serve.sh and scripts/run-zig.sh read this same file; the head is the actor (the watchdog runs
# there, docs/OPERATIONS.md "Watchdog and start at boot"). Arm it with
#   systemctl --user enable --now dsv41-watchdog@prod-zig.timer
# and the boot fast path with dsv41-boot-start@prod-zig.service (docs/INSTALL.md step 5). Set these on the head; the
# worker needs only the engine settings, since nothing supervises from it. STATE_DIR is set above, per node.
RECIPE=zig
# scripts/run-zig.sh names its containers tensorfold-zig-r0 and tensorfold-zig-r1, and that name is the exit witness:
# scripts/serve.sh refuses any other NAME on this recipe.
NAME=tensorfold-zig
# ssh target to the worker (head -> worker), and the absolute path of this checkout ON THE WORKER: the heal launches
# rank 1 there, and rank 1's exit record lives in the STATE_DIR of the worker's own copy of this file.
WORKER_SSH="<user@worker-address>"
WORKER_REPO="<absolute-checkout-path-on-the-worker>"
# The tick's own thresholds. None of them is a stall threshold: a stalled /health 503, a fail-fast exit 70 and the
# engine's stall knobs are the engine's, and the tick only reads what the engine says (docs/OPERATIONS.md).
WATCH_HEAL=1                    # 0: log the alert, restart nothing
WATCH_FAILS=3                   # bad ticks in a row before a debounced verdict heals
WATCH_GRACE=1800                # seconds a young rank 0 may answer nothing (it is loading)
WATCH_MIN_HEAL=1800             # shortest gap between debounced heals, seconds
WATCH_FF_MIN_HEAL=120           # shortest gap between fail-fast heals, seconds
WATCH_HEAL_GRACE=20             # the heal's drain window on rank 0 before the force stop; the engine's own
                                # TF_DSV41_DRAIN_S is 20, so the drain is finished when the force arrives
WATCH_MAX_HEALS=5               # consecutive heals with no clean tick between them, then alert and stop (0: off)
WATCH_EVIDENCE_KEEP=20          # heal-<utc>/ evidence folders kept in STATE_DIR
# Touch the lease to stand the watchdog down (re-touchable). Keep the value on its own line: a trailing
# comment on a path line is part of the path for anything that reads this file with sed.
WATCH_LEASE="<absolute-state-directory>/lease"
WATCH_LEASE_MIN=20              # minutes a lease counts
WATCH_ALERT=""                  # optional: a command called with the alert text
# The idle-wedge probe: one tiny greedy completion, asked only when a 200 /health reports inflight 0 and queued 0.
# The engine has no signal for this family (docs/KNOWN-ISSUES.md), so this is the only look the actor has at it.
# Its cost is one 8-token completion per idle pair per WATCH_PROBE_EVERY_S, counted against WATCH_PROBE_S; a
# completion that never arrives is one debounced bad tick, which heals only after WATCH_FAILS of them. The scripts
# default is off; this profile ships it on.
WATCH_PROBE=1
WATCH_PROBE_S=120               # seconds to wait for the probe's completion
WATCH_PROBE_EVERY_S=120         # minimum gap between probes
# How far back pair_exit looks for a `die` event when a rank left no exit record (a hand-run docker run, an earlyoom
# SIGKILL: no cooperating launcher, so no record). The window opens at the last stop marker when there is one.
WATCH_EXIT_LOOKBACK_S=180
# Boot fast path: the same lease stands the boot start down. BOOT_DRY_RUN=1 shows a decision without starting.
BOOT_LEASE="<absolute-state-directory>/lease"
BOOT_LEASE_MIN=20
# The engine's stall knobs stay the engine's. This file sets TF_DSV41_STALL_EXIT_S=300, so rank 0's round in flight
# longer than five minutes exits 70 and the watchdog restarts both ranks; TF_DSV41_STALL_S, TF_DSV41_STALL_ROUND_S and
# TF_DSV41_STALL_SLOW_S keep their defaults, and the watchdog re-derives no thresholds from any of them.
# TF_DSV41_STALL_ROUND_S (120) is also the base of /health's null-gap verdict. With work in flight and no round ever
# completed, 503 fires when a request has been quiet past the base plus the prompt's prefill estimate at
# GLM53_TF_STALL_PREFILL_TPS (200). A 26k-token first prompt gets 250 s; 0 on either knob turns that verdict off.
TF_DSV41_STALL_EXIT_S=300
# The peer-wait deadline: how long a rank waits inside a round for its peer before it names the wait it was in and
# takes the pair down (exit 70 on both ranks; the fail-fast channel carries the reason to the other one). It arms only
# while a round is open and disarms at its boundary, so an idle pair never ages toward it. A round that admitted a
# prompt widens its own bound by that prompt at GLM53_TF_STALL_PREFILL_TPS - the same allowance the null-gap verdict
# above uses - so a long prefill is not a stall here either. Keep it at or above TF_TP_MAILBOX_TIMEOUT_S (120): the
# transport's own fault record has to land before a peer wait names one, and the engine refuses to boot below that
# order. Keep it above any long in-round host wait as well: an Engram read gets TF_DSV41_ENGRAM_WAIT_S (300). 0 turns
# the layer off, which is what this tree did; GLM53_TF_PEER_WAIT_S wins over the spelling below. This value is not part
# of the settings both ranks must agree on (it only ever ends the process), so the two ranks may differ. The plan
# link's `outstanding` gauge now counts the round markers this layer rides: a round adds two frames to its collectives.
TF_DSV41_PEER_WAIT_S=600
